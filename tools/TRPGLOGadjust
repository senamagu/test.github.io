<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ココフォリアログ整形</title>
<style>
:root{
  --ui-bg:#202124;--ui-panel:#292a2d;--ui-panel2:#323338;--ui-line:#4b4d52;
  --ui-text:#f1f3f4;--ui-sub:#aeb3bb;--accent:#8ab4f8;
  --page-bg:#eeeeee;--page-text:#333333;--bubble:#ffffff;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:"Zen Kaku Gothic New","Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif}
body{background:var(--ui-bg);color:var(--ui-text)}
button,input,select,textarea{font:inherit}
button{cursor:pointer;border:1px solid var(--ui-line);background:var(--ui-panel2);color:var(--ui-text);padding:8px 10px}
button:hover{background:#3b3d42}
button.primary{background:#365f9b;border-color:#5e88c7}
button.danger{background:#7d3030;border-color:#a34a4a}
input,select,textarea{width:100%;background:#191a1d;color:var(--ui-text);border:1px solid var(--ui-line);padding:8px}
textarea{min-height:100px;resize:vertical}
label{display:block;font-size:12px;color:var(--ui-sub);margin:10px 0 5px}
h1,h2,h3{margin:0}
.app{display:grid;grid-template-columns:320px minmax(0,1fr) 390px;height:100vh;overflow:hidden}
.sidebar,.inspector{background:var(--ui-panel);overflow:auto}
.sidebar{border-right:1px solid var(--ui-line);padding:14px}
.inspector{border-left:1px solid var(--ui-line);padding:14px}
.main{min-width:0;display:flex;flex-direction:column}
.topbar{display:flex;gap:7px;align-items:center;padding:10px;border-bottom:1px solid var(--ui-line);background:#242528}
.topbar .grow{flex:1}
.topbar h1{font-size:16px}
.tabs{display:flex;gap:5px;overflow:auto;padding:8px;border-bottom:1px solid var(--ui-line);background:#1c1d20}
.tab{white-space:nowrap}
.tab.active{background:#4b6d9e;border-color:#7195ca}
.preview-wrap{flex:1;overflow:auto;padding:28px;background:#151619}
.page{max-width:900px;margin:0 auto;background:var(--page-bg);color:var(--page-text);padding:42px 48px 70px;min-height:100%;font-family:"Zen Kaku Gothic New","Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif}
.preview-title{text-align:center;font-size:38px;font-weight:800;padding:4px 0 18px;border-bottom:4px solid currentColor;margin-bottom:34px}
.preview-header-img{display:block;max-width:100%;max-height:420px;object-fit:contain;margin:0 auto 28px}
.block{position:relative;margin:18px 0}
.block.selected{outline:2px solid var(--accent);outline-offset:5px}
.block-tools{display:none;position:absolute;right:0;top:-30px;z-index:4;gap:3px}
.block.selected .block-tools{display:flex}
.block-tools button{font-size:11px;padding:4px 6px}
.speech-row{display:flex;gap:14px;align-items:flex-start}
.speech-row.right{flex-direction:row-reverse}
.avatar{width:56px;height:56px;min-width:56px;object-fit:cover;background:#aaa;display:block}
.speech-content{min-width:0;flex:1}
.speaker{font-weight:800;font-size:18px;line-height:1.25;margin:0 0 5px}
.bubble{position:relative;display:block;padding:12px 18px;background:var(--bubble);color:var(--page-text);line-height:1.65;white-space:pre-wrap;overflow-wrap:anywhere}
.bubble.left-tail:before,.bubble.right-tail:before{content:"";position:absolute;top:16px;border:10px solid transparent}
.bubble.left-tail:before{left:-18px;border-right-color:var(--bubble)}
.bubble.right-tail:before{right:-18px;border-left-color:var(--bubble)}
.bubble.normal{border-radius:20px}
.bubble.thought{border-radius:28px}
.bubble.radio{border-radius:0}
.bubble.loud{
  clip-path:polygon(0 9%,4% 0,8% 8%,12% 0,16% 8%,20% 0,24% 8%,28% 0,32% 8%,36% 0,40% 8%,44% 0,48% 8%,52% 0,56% 8%,60% 0,64% 8%,68% 0,72% 8%,76% 0,80% 8%,84% 0,88% 8%,92% 0,96% 8%,100% 0,98% 12%,100% 20%,98% 28%,100% 36%,98% 44%,100% 52%,98% 60%,100% 68%,98% 76%,100% 84%,98% 92%,100% 100%,96% 92%,92% 100%,88% 92%,84% 100%,80% 92%,76% 100%,72% 92%,68% 100%,64% 92%,60% 100%,56% 92%,52% 100%,48% 92%,44% 100%,40% 92%,36% 100%,32% 92%,28% 100%,24% 92%,20% 100%,16% 92%,12% 100%,8% 92%,4% 100%,2% 92%,0 84%,2% 76%,0 68%,2% 60%,0 52%,2% 44%,0 36%,2% 28%,0 20%,2% 12%);
  padding:18px 22px;
}
.bubble.right-tail{margin-right:18px}
.bubble.left-tail{margin-left:18px}
.narration{white-space:pre-wrap;line-height:1.7;overflow-wrap:anywhere}
.narration.center{text-align:center}.narration.right{text-align:right}
.textbox{padding:18px;background:#b6b6b6;color:#fff;display:flex;gap:18px;align-items:center}
.textbox.reverse{flex-direction:row-reverse}
.textbox-main{flex:1;min-width:0}.textbox-title{font-weight:900;font-size:24px;margin-bottom:8px}.textbox-text{white-space:pre-wrap;line-height:1.65}
.textbox img{width:38%;max-width:300px;max-height:260px;object-fit:contain}
.bgm{display:flex;align-items:center;gap:12px;padding:10px 14px;background:#333;color:#eee}
.bgm audio{flex:1;min-width:0}
.media img,.media video{display:block;max-width:100%;max-height:600px;margin:auto}
.media audio{width:100%}
.separator{height:4px;background:currentColor;margin:28px 0}
.roll.success,.roll.critical{color:#00a9b3}.roll.failure,.roll.fumble{color:#c74720}
.roll{white-space:pre-wrap;font-weight:700;line-height:1.65}
.section-label{font-size:12px;color:var(--ui-sub);margin:15px 0 6px;text-transform:uppercase}
.panel{background:var(--ui-panel2);border:1px solid var(--ui-line);padding:10px;margin-bottom:10px}
.row{display:flex;gap:6px}.row>*{flex:1}
.list{display:flex;flex-direction:column;gap:5px}
.list-item{display:flex;align-items:center;gap:6px;padding:7px;background:#222428;border:1px solid #3d3f44}
.list-item span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.small{font-size:11px;color:var(--ui-sub)}
.empty{padding:30px;text-align:center;color:var(--ui-sub)}
.color-row{display:flex;gap:6px;align-items:center}.color-row input[type=color]{width:44px;padding:2px;height:36px}
.check{display:flex;gap:7px;align-items:center;color:var(--ui-text);font-size:13px}.check input{width:auto}
@media(max-width:1100px){.app{grid-template-columns:270px minmax(0,1fr)}.inspector{position:fixed;right:0;top:0;bottom:0;width:min(390px,92vw);z-index:20;box-shadow:-8px 0 30px #0008;transform:translateX(100%);transition:.18s}.inspector.open{transform:none}.page{padding:32px 24px}}
@media(max-width:700px){.app{display:block;height:auto;min-height:100vh}.sidebar{position:sticky;top:0;z-index:10;border:0;border-bottom:1px solid var(--ui-line);max-height:44vh}.main{height:calc(100vh - 44vh)}.preview-wrap{padding:10px}.page{padding:28px 15px 50px}.speech-row{gap:9px}.avatar{width:42px;height:42px;min-width:42px}.speaker{font-size:15px}.bubble{padding:9px 13px}.preview-title{font-size:28px}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
  <h2>ココフォリアログ整形</h2>
  <div class="section-label">読み込み</div>
  <div class="panel">
    <input id="fileInput" type="file" multiple accept=".html,.htm,.json,.png,.jpg,.jpeg,.webp,.gif,.apng,.mp4,.mov,.wav,.mp3,.ogg">
    <div class="small" style="margin-top:7px">HTML(新/旧)・JSON・画像/動画/音声を読み込めます。画像等は挿入素材として登録します。</div>
  </div>
  <div class="row">
    <button id="addTab">タブ追加</button>
    <button id="mergeTabs">全タブ結合</button>
  </div>
  <div class="section-label">タブ</div>
  <div id="tabList" class="list"></div>
  <div class="section-label">ブロック追加</div>
  <div class="panel">
    <div class="row">
      <button data-add="narration">地の文</button>
      <button data-add="bubble">吹き出し</button>
    </div>
    <div class="row" style="margin-top:6px">
      <button data-add="textbox">テキストボックス</button>
      <button data-add="separator">区切り線</button>
    </div>
    <div class="row" style="margin-top:6px">
      <button data-add="media">画像/動画/音声</button>
      <button data-add="bgm">BGM</button>
    </div>
  </div>
  <div class="section-label">キャラクター</div>
  <div id="charList" class="list"></div>
  <button id="addChar" style="width:100%;margin-top:6px">＋ キャラクター追加</button>
  <div class="section-label">保存</div>
  <div class="row"><button id="backupExport">バックアップ書出</button><button id="backupImport">バックアップ読込</button></div>
  <input id="backupInput" type="file" accept=".json" hidden>
  <button id="reset" class="danger" style="width:100%;margin-top:6px">データリセット</button>
</aside>

<main class="main">
  <div class="topbar">
    <h1 id="activeName">プレビュー</h1><div class="grow"></div>
    <button id="settingsBtn">全体設定</button>
    <button id="exportBtn" class="primary">HTML書出</button>
    <button id="inspectorBtn">編集</button>
  </div>
  <div id="tabs" class="tabs"></div>
  <div class="preview-wrap"><div id="page" class="page"></div></div>
</main>

<aside id="inspector" class="inspector">
  <h2 id="inspectorTitle">編集</h2>
  <div id="inspectorBody"></div>
</aside>
</div>

<script>
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const uid=()=>crypto.randomUUID?.()||Date.now().toString(36)+Math.random().toString(36).slice(2);
const esc=s=>String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
const clone=o=>JSON.parse(JSON.stringify(o));
const defaultSettings={
  title:"タイトル",titleColor:"#333333",headerImage:null,
  pageBg:"#eeeeee",rootBg:"#777777",logBg:"#eeeeee",baseText:"#333333",baseBubble:"#ffffff",
  font:'"Zen Kaku Gothic New","Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif',
  colors:{system:"#666666",success:"#00a9b3",critical:"#00a9b3",failure:"#c74720",fumble:"#c74720"}
};
let state={settings:defaultSettings,characters:{},tabs:[],activeTab:null,selected:null,media:{}};

function newTab(name="ログ"){
  const t={id:uid(),name,blocks:[]}; state.tabs.push(t); state.activeTab=t.id; return t;
}
function getTab(){return state.tabs.find(t=>t.id===state.activeTab)||state.tabs[0]}
function charFor(name,color,icon){
  const key=String(name||"").trim();
  if(!key||key==="system"||key==="　") return null;
  if(!state.characters[key]) state.characters[key]={id:uid(),name:key,nameColor:color||"#333333",textColor:state.settings.baseText,icon:icon||null,narration:false,expressions:[]};
  else if(icon&&!state.characters[key].icon) state.characters[key].icon=icon;
  return state.characters[key];
}
function makeBlock(type,data={}){
  return Object.assign({id:uid(),type,createdAt:Date.now(),text:"",name:"",nameColor:"#333333",textColor:state.settings.baseText,bubbleColor:state.settings.baseBubble,direction:"left",shape:"normal",size:"normal",showName:true,align:"left",boxColor:"#aaaaaa",title:"",image:null,media:null,mediaKind:"image",imageSide:"right",srcTab:null},data);
}
function save(){try{localStorage.setItem("cocofolia_formatter_v1",JSON.stringify(state))}catch(e){console.warn(e)}}
function load(){try{const x=localStorage.getItem("cocofolia_formatter_v1");if(x){state=JSON.parse(x);if(!state.tabs.length)newTab();return true}}catch(e){}newTab();return false}
function sizeClass(s){return ({h1:"h1",h2:"h2",h3:"h3",normal:"normal",small:"small"})[s]||"normal"}
function fontSize(s){return ({h1:"2.1em",h2:"1.7em",h3:"1.35em",normal:"1em",small:".78em"})[s]||"1em"}

function renderTabs(){
  $("#tabs").innerHTML=state.tabs.map(t=>`<button class="tab ${t.id===state.activeTab?"active":""}" data-tab="${t.id}">${esc(t.name)}</button>`).join("");
  $("#tabList").innerHTML=state.tabs.map(t=>`<div class="list-item"><span>${esc(t.name)}</span><button data-tab="${t.id}">開く</button></div>`).join("");
  $$("#tabs [data-tab],#tabList [data-tab]").forEach(b=>b.onclick=()=>{state.activeTab=b.dataset.tab;state.selected=null;render()});
}
function renderChars(){
  $("#charList").innerHTML=Object.values(state.characters).map(c=>`<div class="list-item"><span style="color:${esc(c.nameColor)}">${esc(c.name)}</span><button data-char="${esc(c.id)}">設定</button></div>`).join("")||'<div class="small">読み込むとキャラクターがここに並びます。</div>';
  $$("#charList [data-char]").forEach(b=>b.onclick=()=>charEditor(b.dataset.char));
}
function render(){
  renderTabs();renderChars();
  const t=getTab();$("#activeName").textContent=t?t.name:"プレビュー";
  renderPage();
  renderInspector();
  save();
}
function blockTools(b){
 return `<div class="block-tools"><button data-act="up">↑</button><button data-act="down">↓</button><button data-act="insert">＋</button><button data-act="del" class="danger">削除</button></div>`;
}
function renderPage(){
 const p=$("#page"); if(!getTab()){p.innerHTML="";return}
 const s=state.settings;
 p.style.background=s.logBg;p.style.color=s.baseText;p.style.fontFamily=s.font;
 let html=`<div class="preview-title" style="color:${esc(s.titleColor)}">${esc(s.title)}</div>`;
 if(s.headerImage) html+=`<img class="preview-header-img" src="${esc(s.headerImage)}">`;
 html+=getTab().blocks.map((b,i)=>{
   const sel=state.selected===b.id;
   let content="";
   if(b.type==="bubble"){
     const c=state.characters[b.name]||{};
     const icon=b.icon||c.icon;
     content=`<div class="speech-row ${b.direction==="right"?"right":""}">
       ${icon?`<img class="avatar" src="${esc(icon)}">`:`<div class="avatar"></div>`}
       <div class="speech-content">${b.showName?`<div class="speaker" style="color:${esc(b.nameColor||c.nameColor||s.baseText)}">${esc(b.name)}</div>`:""}
       <div class="bubble ${esc(b.shape)} ${b.direction==="right"?"right-tail":"left-tail"}" style="background:${esc(b.bubbleColor||s.baseBubble)};color:${esc(b.textColor||c.textColor||s.baseText)};font-size:${fontSize(b.size)}">${esc(b.text)}</div></div></div>`;
   }else if(b.type==="narration"){
     content=`<div class="narration ${b.align}" style="color:${esc(b.textColor||s.baseText)};font-size:${fontSize(b.size)}">${b.showName&&b.name?`<strong>${esc(b.name)}：</strong>`:""}${esc(b.text)}</div>`;
   }else if(b.type==="textbox"){
     content=`<div class="textbox ${b.imageSide==="left"?"reverse":""}" style="background:${esc(b.boxColor)};color:${esc(b.textColor)}">
       <div class="textbox-main">${b.title?`<div class="textbox-title">${esc(b.title)}</div>`:""}<div class="textbox-text">${esc(b.text)}</div></div>
       ${b.image?`<img src="${esc(b.image)}">`:""}</div>`;
   }else if(b.type==="bgm"){
     content=`<div class="bgm"><span style="color:${esc(b.textColor)};background:${esc(b.bgColor)};padding:4px 8px">${esc(b.text||"BGM")}</span><audio controls src="${esc(b.media||"")}"></audio></div>`;
   }else if(b.type==="media"){
     if(b.mediaKind==="audio") content=`<div class="media"><audio controls src="${esc(b.media||"")}"></audio></div>`;
     else if(b.mediaKind==="video") content=`<div class="media"><video controls src="${esc(b.media||"")}"></video></div>`;
     else content=`<div class="media"><img src="${esc(b.media||"")}"></div>`;
   }else if(b.type==="separator") content=`<div class="separator" style="color:${esc(b.color||s.baseText)}"></div>`;
   return `<div class="block ${sel?"selected":""}" data-block="${b.id}">${blockTools(b)}${content}</div>`;
 }).join("");
 p.innerHTML=html||'<div class="empty">ログがありません。左側から読み込むか、ブロックを追加してください。</div>';
 $$("#page .block").forEach(el=>{
   el.onclick=e=>{if(e.target.closest(".block-tools"))return;state.selected=el.dataset.block;renderInspector();renderPage()};
   $$("#page .block-tools button",el).forEach(btn=>btn.onclick=e=>{e.stopPropagation();blockAction(el.dataset.block,btn.dataset.act)});
 });
}
function blockAction(id,act){
 const t=getTab(),i=t.blocks.findIndex(b=>b.id===id);if(i<0)return;
 if(act==="up"&&i>0)[t.blocks[i-1],t.blocks[i]]=[t.blocks[i],t.blocks[i-1]];
 if(act==="down"&&i<t.blocks.length-1)[t.blocks[i+1],t.blocks[i]]=[t.blocks[i],t.blocks[i+1]];
 if(act==="del"){t.blocks.splice(i,1);state.selected=null}
 if(act==="insert"){const n=makeBlock("narration",{text:"新しい地の文"});t.blocks.splice(i+1,0,n);state.selected=n.id}
 render();
}
function inputField(label,id,value,type="text"){
 return `<label>${label}</label><input id="${id}" type="${type}" value="${esc(value)}">`;
}
function colorField(label,id,value){
 return `<label>${label}</label><div class="color-row"><input id="${id}" type="color" value="${esc(value||"#ffffff")}"><input id="${id}Text" value="${esc(value||"#ffffff")}"></div>`;
}
function bindCommonBlock(b){
 const ids=["text","name","nameColor","textColor","bubbleColor","direction","shape","size","showName","align","boxColor","title","imageSide","media","mediaKind","bgColor","color"];
 ids.forEach(k=>{const el=$("#f_"+k);if(!el)return;el.oninput=el.onchange=()=>{let v=el.type==="checkbox"?el.checked:el.value;b[k]=v;save();renderPage()}})
 $$("#inspectorBody input[type=color]").forEach(el=>{el.oninput=()=>{const key=el.id.replace("f_","");b[key]=el.value;const tx=$("#"+el.id+"Text");if(tx)tx.value=el.value;renderPage();save()}});
 $$("#inspectorBody input[id$=Text]").forEach(el=>el.oninput=()=>{const key=el.id.replace("Text","").replace("f_","");b[key]=el.value;const c=$("#f_"+key);if(c)c.value=el.value;renderPage();save()});
}
function renderInspector(){
 const body=$("#inspectorBody"),b=getTab()?.blocks.find(x=>x.id===state.selected);
 if(!b){body.innerHTML=`<div class="panel"><b>全体設定</b><p class="small">要素をクリックすると個別編集できます。</p></div>`;return}
 let h=`<div class="panel"><div class="small">種類</div><b>${esc(b.type)}</b></div>`;
 if(b.type==="bubble"){
   h+=inputField("キャラクター名","f_name",b.name)+
      colorField("名前色","f_nameColor",b.nameColor)+colorField("吹き出し色","f_bubbleColor",b.bubbleColor)+colorField("本文色","f_textColor",b.textColor)+
      `<label>吹き出し形</label><select id="f_shape"><option value="normal">通常角丸</option><option value="thought">心情（丸）</option><option value="radio">ラジオ（四角）</option><option value="loud">大声（トゲトゲ）</option></select>`+
      `<label>文字サイズ</label><select id="f_size"><option value="h1">見出し1</option><option value="h2">見出し2</option><option value="h3">見出し3</option><option value="normal">通常</option><option value="small">小さい</option></select>`+
      `<label>向き</label><select id="f_direction"><option value="left">左</option><option value="right">右</option></select>`+
      `<label class="check"><input id="f_showName" type="checkbox"> 名前を表示</label>`+
      `<label>本文</label><textarea id="f_text">${esc(b.text)}</textarea>`+
      `<div class="panel" style="margin-top:10px"><button id="convertNarration">地の文に変換</button><button id="convertTextbox">テキストボックスに変換</button></div>`;
 }else if(b.type==="narration"){
   h+=`<label>文字サイズ</label><select id="f_size"><option value="h1">見出し1</option><option value="h2">見出し2</option><option value="h3">見出し3</option><option value="normal">通常</option><option value="small">小さい</option></select>
   <label>揃え</label><select id="f_align"><option value="left">左</option><option value="center">中央</option><option value="right">右</option></select>
   <label class="check"><input id="f_showName" type="checkbox"> 名前を表示</label>${inputField("名前","f_name",b.name)}
   ${colorField("本文色","f_textColor",b.textColor)}<label>本文</label><textarea id="f_text">${esc(b.text)}</textarea>
   <div class="panel"><button id="convertBubble">吹き出しに変換</button><button id="convertTextbox">テキストボックスに変換</button></div>`;
 }else if(b.type==="textbox"){
   h+=colorField("ボックス色","f_boxColor",b.boxColor)+colorField("本文色","f_textColor",b.textColor)+inputField("タイトル（空欄可）","f_title",b.title)+
   `<label>画像位置</label><select id="f_imageSide"><option value="right">←テキスト / 画像→</option><option value="left">←画像 / テキスト→</option></select>
   <label>本文</label><textarea id="f_text">${esc(b.text)}</textarea>
   <label>画像</label><input id="mediaPicker" type="file" accept="image/*">`;
 }else if(b.type==="bgm"){
   h+=inputField("表示名","f_text",b.text)+colorField("背景色","f_bgColor",b.bgColor||"#333333")+colorField("文字・再生バー色","f_textColor",b.textColor||"#eeeeee")+
   `<label>音声ファイル</label><input id="mediaPicker" type="file" accept="audio/*">`;
 }else if(b.type==="media"){
   h+=`<label>種類</label><select id="f_mediaKind"><option value="image">画像</option><option value="video">動画</option><option value="audio">音声</option></select><label>ファイル</label><input id="mediaPicker" type="file" accept="image/*,video/*,audio/*">`;
 }else if(b.type==="separator"){
   h+=colorField("線の色","f_color",b.color||state.settings.baseText);
 }
 body.innerHTML=h;
