function exportBlock(b){
 if(b.type==="bubble"){const c=state.characters[b.name]||{},icon=b.icon||c.icon;return `<div class="speech ${b.direction==="right"?"right":""}">${icon?`<img class="avatar" src="${esc(icon)}">`:`<div class="avatar"></div>`}<div class="content">${b.showName?`<div class="speaker" style="color:${esc(b.nameColor)}">${esc(b.name)}</div>`:""}<div class="bubble ${esc(b.shape)}" style="background:${esc(b.bubbleColor)};color:${esc(b.textColor)};font-size:${fontSize(b.size)}">${esc(b.text)}</div></div></div>`}
 if(b.type==="narration")return `<div class="narration" style="color:${esc(b.textColor)};font-size:${fontSize(b.size)};text-align:${esc(b.align)}">${b.showName&&b.name?`<strong>${esc(b.name)}：</strong>`:""}${esc(b.text)}</div>`;
 if(b.type==="textbox")return `<div class="textbox ${b.imageSide==="left"?"reverse":""}" style="background:${esc(b.boxColor)};color:${esc(b.textColor)}"><div class="textbox-main">${b.title?`<div class="textbox-title">${esc(b.title)}</div>`:""}<div class="textbox-text">${esc(b.text)}</div></div>${b.image?`<img src="${esc(b.image)}">`:""}</div>`;
 if(b.type==="bgm")return `<div class="bgm"><span style="color:${esc(b.textColor)}">${esc(b.text||"BGM")}</span><audio controls src="${esc(b.media||"")}"></audio></div>`;
 if(b.type==="media"){return b.mediaKind==="video"?`<div class="media"><video controls src="${esc(b.media)}"></video></div>`:b.mediaKind==="audio"?`<div class="media"><audio controls src="${esc(b.media)}"></audio></div>`:`<div class="media"><img src="${esc(b.media)}"></div>`}
 return `<div class="sep"></div>`;
