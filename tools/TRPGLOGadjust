 $("#c_nameColor").oninput=e=>{c.nameColor=e.target.value;renderPage();save()};$("#c_nameColorText").oninput=e=>{c.nameColor=e.target.value;$("#c_nameColor").value=c.nameColor;renderPage();save()};
 $("#c_textColor").oninput=e=>{c.textColor=e.target.value;renderPage();save()};$("#c_textColorText").oninput=e=>{c.textColor=e.target.value;$("#c_textColor").value=c.textColor;renderPage();save()};
