rap;line-height:1.65}.textbox img{width:38%;max-height:260px;object-fit:contain}.media img,.media video{display:block;max-width:100%;max-height:600px;margin:auto}.media audio{width:100%}.bgm{display:flex;gap:12px;align-items:center;background:#333;padding:10px 14px;margin:18px 0}.bgm audio{flex:1}.sep{height:4px;margin:28px 0;background:${s.baseText}}
</style></head><body><main class="wrap"><div class="title">${esc(s.title)}</div>${s.headerImage?`<img class="header" src="${esc(s.headerImage)}">`:""}<div class="tabs">${tabs}</div>${blocks}</main><script>
const ts=[...document.querySelectorAll(".tab")], ls=[...document.querySelectorAll(".logtab")];function show(id){ts.forEach(x=>x.classList.toggle("active",x.dataset.tab===id));ls.forEach(x=>x.classList.toggle("active",x.id==="tab_"+id))}ts.forEach(x=>x.onclick=()=>show(x.dataset.tab));if(ts[0])show(ts[0].dataset.tab);
<\/script></body></html>`;
 const blob=new Blob([doc],{type:"text/html;charset=utf-8"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=(s.title||"cocofolia-log")+".html";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)
