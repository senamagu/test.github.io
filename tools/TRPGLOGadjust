function addBlock(type){
 const t=getTab();let b=makeBlock(type);
 if(type==="bubble"){b.name=Object.keys(state.characters)[0]||"新キャラクター";charFor(b.name,"#333333");}
 if(type==="narration")b.text="新しい地の文";
 if(type==="textbox")b.text="ボックス本文";
 if(type==="bgm")b.text="BGM";
 t.blocks.push(b);state.selected=b.id;render();
}
async function importJSON(text,name){
 const j=JSON.parse(text), msgs=Array.isArray(j.messages)?j.messages:[];
 const groups=new Map();
 msgs.forEach((m,idx)=>{
   const key=m.channel||"main";if(!groups.has(key))groups.set(key,{name:m.channelName||key,blocks:[]});
   const roll=m.extend?.roll;let type=m.type==="system"||m.name==="system"?"narration":(m.name==="　"||!m.iconImage?"narration":"bubble");
   const c=type==="bubble"?charFor(m.name,m.color):null;
   const b=makeBlock(type,{text:roll?.result||m.text||"",name:m.name||"",nameColor:m.color||"#333333",textColor:m.color||state.settings.baseText,createdAt:Number(m.createdAt)||idx,icon:null});
   if(roll){if(roll.critical)b.textColor=state.settings.colors.critical;else if(roll.fumble)b.textColor=state.settings.colors.fumble;else if(roll.success)b.textColor=state.settings.colors.success;else if(roll.failure)b.textColor=state.settings.colors.failure}
   groups.get(key).blocks.push(b);
 });
 for(const [key,g] of groups){const t=newTab(name+(groups.size>1?" / "+g.name:""));t.blocks=g.blocks.sort((a,b)=>a.createdAt-b.createdAt)}
}
function parseOld(doc,name){
 const ps=[...doc.querySelectorAll("body p")],groups=new Map();
 ps.forEach((p,i)=>{
   const spans=p.querySelectorAll("span");if(spans.length<3)return;
   const channel=(spans[0].textContent.match(/\[(.*?)\]/)||[])[1]||"main", speaker=spans[1].textContent.trim(),text=spans[2].textContent.trim();
   if(!groups.has(channel))groups.set(channel,[]);
   const isNarr=!speaker||speaker==="　"||speaker==="system";
   const b=makeBlock(isNarr?"narration":"bubble",{name:speaker,text:text.replace(/<br\s*\/?>/gi,"\n"),nameColor:p.style.color||"#333333",textColor:p.style.color||state.settings.baseText,createdAt:i});
   if(!isNarr)charFor(speaker,p.style.color);
   groups.get(channel).push(b);
 });
 for(const [ch,blocks] of groups){const t=newTab(name+(groups.size>1?" / "+ch:""));t.blocks=blocks}
}
function parseNew(doc,name){
 const avatarMap={};
 [...doc.querySelectorAll("style")].forEach(st=>{const re=/\.avatar-image-(\d+)[^{]*\{[^}]*background-image:\s*url\(["']?(data:[^)"']+)["']?\)/g;let m;while((m=re.exec(st.textContent)))avatarMap[m[1]]=m[2]});
 const groups=new Map();
 [...doc.querySelectorAll("article.message")].forEach((el,i)=>{
   const channel=el.dataset.channel||"main", speaker=el.querySelector(".speaker")?.textContent.trim()||"", text=el.querySelector(".message-text")?.textContent.trim()||"", time=el.querySelector("time")?.getAttribute("datetime");
   if(!groups.has(channel))groups.set(channel,[]);
   const isSystem=el.classList.contains("system"), isNarr=!speaker||speaker==="　"||isSystem;
   const sp=el.querySelector(".speaker"), color=sp?.style.getPropertyValue("--speaker-color")?.trim()||"#333333";
   const av=el.querySelector(".avatar"), cls=av?.className.match(/avatar-image-(\d+)/);const icon=cls?avatarMap[cls[1]]:null;
   const b=makeBlock(isNarr?"narration":"bubble",{name:speaker,text,nameColor:color,textColor:color,createdAt:time?Date.parse(time):i,icon});
   if(!isNarr)charFor(speaker,color,icon);
   groups.get(channel).push(b);
 });
 const title=doc.querySelector(".log-title")?.textContent.trim();if(title&&!state.settings.title)state.settings.title=title;
 for(const [ch,blocks] of groups){const t=newTab(name+(groups.size>1?" / "+ch:""));t.blocks=blocks.sort((a,b)=>a.createdAt-b.createdAt)}
}
async function importFiles(files){
 for(const f of files){
   if(/\.(png|jpe?g|webp|gif|apng)$/i.test(f.name)){const b=makeBlock("media",{media:await fileData(f),mediaKind:"image",text:f.name});getTab().blocks.push(b);continue}
   if(/\.(mp4|mov)$/i.test(f.name)){const b=makeBlock("media",{media:await fileData(f),mediaKind:"video",text:f.name});getTab().blocks.push(b);continue}
   if(/\.(wav|mp3|ogg)$/i.test(f.name)){const b=makeBlock("bgm",{media:await fileData(f),text:f.name});getTab().blocks.push(b);continue}
   const text=await f.text();
   try{if(/\.json$/i.test(f.name))await importJSON(text,f.name.replace(/\.[^.]+$/,""));else{const doc=new DOMParser().parseFromString(text,"text/html");if(doc.querySelector("article.message"))parseNew(doc,f.name.replace(/\.[^.]+$/,""));else parseOld(doc,f.name.replace(/\.[^.]+$/,""))}}catch(e){alert(f.name+" の読み込みに失敗しました。\n"+e.message)}
 }
 render();
}
