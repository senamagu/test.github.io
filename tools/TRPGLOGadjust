 $("#inspector").classList.add("open");const s=state.settings;
 $("#inspectorBody").innerHTML=`${inputField("タイトル","s_title",s.title)}${colorField("タイトル色","s_titleColor",s.titleColor)}
 ${colorField("HTML/ページ背景","s_pageBg",s.pageBg)}${colorField("ログ領域背景","s_logBg",s.logBg)}${colorField("基本文字色","s_baseText",s.baseText)}${colorField("基本吹き出し色","s_baseBubble",s.baseBubble)}
 <label>フォント</label><input id="s_font" value="${esc(s.font)}">
 <div class="panel"><b>ダイス結果色</b>${colorField("system","s_system",s.colors.system)}${colorField("成功","s_success",s.colors.success)}${colorField("クリティカル/スペシャル","s_critical",s.colors.critical)}${colorField("失敗","s_failure",s.colors.failure)}${colorField("ファンブル","s_fumble",s.colors.fumble)}</div>
