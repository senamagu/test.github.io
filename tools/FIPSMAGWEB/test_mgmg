splay:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:38px}.heading h2{font:clamp(48px,8vw,115px)/.95 'Archivo Black';letter-spacing:-.065em;margin:0}.heading p{font-size:13px;font-weight:700;line-height:1.9;max-width:370px}.works{background:var(--paper)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.work-card{min-height:390px;position:relative;border:3px solid var(--ink);overflow:hidden;box-shadow:8px 8px 0 var(--ink);transition:transform .2s}.work-card:hover{transform:translateY(-8px)}.work-card:nth-child(1){background:#f6b6c9}.work-card:nth-child(2){background:#b7d8ed}.work-card:nth-child(3){background:#e4e7a4}.work-art{position:absolute;inset:0;display:grid;place-items:center;font:clamp(100px,13vw,210px) 'Archivo Black';color:#ffffff99;transform:rotate(-15deg)}.work-card .meta{position:absolute;left:20px;right:20px;bottom:20px;background:#fff;padding:20px;border:2px solid var(--ink)}.work-card .meta small{font-weight:900;letter-spacing:.2em}.work-card h3{font-size:24px;margin:6px 0}.work-card p{font-size:12px;margin:0}.feature{background:var(--ink);color:#fff;display:grid;grid-template-columns:1fr 1fr;gap:8vw;align-items:center}.feature .heading{display:block}.feature .heading h2{font-size:clamp(48px,7vw,100px)}.feature p{line-height:2;font-weight:600}.train{height:300px;position:relative;background:#e7e6d7;border:8px solid #fff;border-radius:35px;overflow:hidden;box-shadow:12px 12px 0 #ffffff30}.train:before{content:'';position:absolute;inset:20px;background:repeating-linear-gradient(90deg,#336d7f 0 8%,#f5f3dc 8% 11%,#336d7f 11% 30%);border-radius:18px}.train:after{content:'FATUrAIN';position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-5deg);font:clamp(32px,5vw,70px) 'Archivo Black';color:#fff;text-shadow:4px 5px 0 #172e39;background:#f0719a;padding:12px 25px;border:3px solid white}.feature .pill{background:#ffebee;color:var(--ink);margin-top:18px}.links{display:grid;grid-template-columns:repeat(