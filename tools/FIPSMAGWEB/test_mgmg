background:var(--paper);padding:24px;flex-direction:column;align-items:start;border-bottom:2px solid var(--ink)}nav.open{display:flex}.menu{display:block}.hero{min-height:700px;height:92svh}.hero-type{top:14%;left:6%}.hero-type h1{font-size:clamp(70px,16vw,125px)}.hero-type p{font-size:11px;max-width:280px}.layer{width:calc(var(--w) * 1.5)}.hero-bottom{bottom:12%}.cards{grid-template-columns:1fr}.work-card{min-height:320px}.feature{grid-template-columns:1fr;gap:35px}.links{grid-template-columns:1fr}.link-card{min-height:180px}.heading{display:block}.heading p{max-width:100%}.section{padding:75px 24px}.scroll{display:none}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}}
