<button class="editor-toggle" id="editorToggle">⚙ レイヤー編集</button><aside class="editor" id="editor"><h3>トップ画像の配置調整</h3><p>キャラの画像を読み込んで、位置・大きさ・角度を変更できる。設定はこのブラウザに保存。画像自体は保存されないため、再読込後は再選択が必要。</p><label for="layerSelect">編集するレイヤー</label><select id="layerSelect"><option value="0">キャラクター A</option><option value="1">キャラクター B</option><option value="2">キャラクター C</option></select><label for="upload">画像を読み込む（PNG / WebP など）</label><input type="file" id="upload" accept="image/*"><div id="controls"></div><button id="resetLayer" class="secondary">このレイヤーを初期化</button><button id="exportSettings">設定JSONを出力</button><label for="importSettings">設定JSONを読み込む</label><input id="importSettings" type="file" accept="application/json,.json"><p class="note">試作版：PC・スマホで別々の位置を保存できる。公開用の画像管理・ログイン機能は今後実装。</p></aside>
<script>
const defaults=[{desktop:{x:72,y:57,w:22,r:-10},mobile:{x:73,y:61,w:32,r:-10}},{desktop:{x:88,y:61,w:19,r:9},mobile:{x:93,y:66,w:30,r:9}},{desktop:{x:55,y:75,w:17,r:7},mobile:{x:42,y:77,w:29,r:7}}];
let settings;try{settings=JSON.parse(localStorage.getItem('magoc-hero-layers'))||structuredClone(defaults)}catch{settings=structuredClone(defaults)}if(!Array.isArray(settings)||settings.length!==3)settings=structuredClone(defaults);
const els=[...document.querySelectorAll('.layer')],select=document.getElementById('layerSelect'),controls=document.getElementById('controls');let urls={};const device=()=>window.innerWidth<=850?'mobile':'desktop';function render(){els.forEach((el,i)=>{const s=settings[i][device()]||defaults[i][device()];el.style.setProperty('--x',s.x+'%');el.style.setProperty('--y',s.y+'%');el.style.setProperty('--w',s.w+'%');el.style.setProperty('--r',s.r+'deg')})}function save(){localStorage.setItem('magoc-hero-layers',JSON.stringify(settings));render()}
function drawControls(){controls.replaceChildren();const i=+select.value,s=settings[i][device()];[['x','横位置',0,100,1,'%'],['y','縦位置',0,100,1,'%'],['w','大きさ',5,70,1,'%'],['r','回転',-180,180,1,'°']].forEach(([key,name,min,max,step,unit])=>{const label=document.createElement('label'),head=document.createElement('div'),value=document.createElement('span'),input=document.createElement('input');head.className='control';head.textContent=name;value.textContent=s[key]+unit;head.append(value);input.type='range';input.min=min;input.max=max;input.step=step;input.value=s[key];input.addEventListener('input',()=>{s[key]=+input.value;value.textContent=s[key]+unit;save()});label.append(head,input);controls.append(label)})}select.addEventListener('change',drawControls);window.addEventListener('resize',()=>{render();drawControls()});document.getElementById('upload').addEventListener('change',e=>{const file=e.target.files[0];if(!file)return;const i=+select.value;if(urls[i])URL.revokeObjectURL(urls[i]);urls[i]=URL.createObjectURL(file);els[i].replaceChildren(Object.assign(document.createElement('img'),{src:urls[i],alt:'アップロードしたキャラクター画像'}))});document.getElementById('resetLayer').addEventListener('click',()=>{const i=+select.value;settings[i][device()]=structuredClone(defaults[i][device()]);save();drawControls()});document.getElementById('exportSettings').addEventListener('click',()=>{const blob=new Blob([JSON.stringify({version:1,layers:settings},null,2)],{type:'application/json'}),a=document.createElement('a'),url=URL.createObjectURL(blob);a.href=url;a.download='magoc-hero-settings.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)});document.getElementById('importSettings').addEventListener('change',async e=>{const f=e.target.files[0];if(!f)return;try{const parsed=JSON.parse(await f.text());if(!Array.isArray(parsed.layers)||parsed.layers.length!==3||!parsed.layers.every(l=>['desktop','mobile'].every(d=>l[d]&&['x','y','w','r'].every(k=>typeof l[d][k]==='number'&&Number.isFinite(l[d][k])))))throw Error();settings=parsed.layers;save();drawControls();alert('位置設定を読み込んだぞ！')}catch{alert('この試作版に対応した設定JSONではないようだ。')}});document.getElementById('editorToggle').addEventListener('click',()=>document.getElementById('editor').classList.toggle('open'));document.getElementById('menu').addEventListener('click',()=>document.getElementById('nav').classList.toggle('open'));document.querySelectorAll('nav a').forEach(a=>a.addEventListener('click',()=>document.getElementById('nav').classList.remove('open')));const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');observer.unobserve(e.target)}}),{threshold:.1});document.querySelectorAll('.reveal').forEach(e=>observer.observe(e));render();drawControls();
</script></body></html>
